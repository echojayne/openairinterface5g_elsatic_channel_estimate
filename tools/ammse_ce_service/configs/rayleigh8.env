# Source this file before starting the elastic A-MMSE RFsim workflow.
# It is compatible with bash and zsh and derives paths from this repository.

if [ -n "${BASH_VERSION:-}" ]; then
  _ammse_config_file="${BASH_SOURCE}"
elif [ -n "${ZSH_VERSION:-}" ]; then
  _ammse_config_file="${(%):-%x}"
else
  _ammse_config_file="$0"
fi

_ammse_config_dir="$(cd "$(dirname "${_ammse_config_file}")" && pwd)"
_ammse_service_dir="$(cd "${_ammse_config_dir}/.." && pwd)"
_ammse_oai_root="$(cd "${_ammse_service_dir}/../.." && pwd)"

export OAI_BUILD_DIR="${OAI_BUILD_DIR:-${_ammse_oai_root}/cmake_targets/ran_build_local/build}"
export NR_SOFTMODEM="${NR_SOFTMODEM:-${OAI_BUILD_DIR}/nr-softmodem}"

if [ -z "${PYTHON_BIN:-}" ]; then
  if command -v python >/dev/null 2>&1; then
    PYTHON_BIN="$(python -c 'import sys; print(sys.executable)' 2>/dev/null || true)"
  fi
  if [ -z "${PYTHON_BIN:-}" ]; then
    PYTHON_BIN="$(command -v python3)"
  fi
  export PYTHON_BIN
fi

case ":${LD_LIBRARY_PATH:-}:" in
  *":${OAI_BUILD_DIR}:"*) ;;
  *) export LD_LIBRARY_PATH="${OAI_BUILD_DIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" ;;
esac

export OAI_AMMSE_CE_METHOD="${OAI_AMMSE_CE_METHOD:-strujepa}"
export OAI_AMMSE_CE_CHECKPOINT="${OAI_AMMSE_CE_CHECKPOINT:-${_ammse_service_dir}/checkpoints/strujepa_best.pt}"
export OAI_AMMSE_CE_RUN_ID="${OAI_AMMSE_CE_RUN_ID:-rayleigh8_$(date +%Y%m%d_%H%M%S)}"
export OAI_AMMSE_CE_OUTPUT_DIR="${OAI_AMMSE_CE_OUTPUT_DIR:-${_ammse_service_dir}/runs/${OAI_AMMSE_CE_RUN_ID}}"

export OAI_AMMSE_CE_WIDTH="${OAI_AMMSE_CE_WIDTH:-0.25}"
export OAI_AMMSE_CE_DEPTH="${OAI_AMMSE_CE_DEPTH:-0.25}"
export OAI_AMMSE_CE_PRINT_EVERY="${OAI_AMMSE_CE_PRINT_EVERY:-100}"
export OAI_AMMSE_CE_TIMING_PRINT_EVERY="${OAI_AMMSE_CE_TIMING_PRINT_EVERY:-100}"

export OAI_AMMSE_CE_ENABLE_RFSIM_CHANMOD="${OAI_AMMSE_CE_ENABLE_RFSIM_CHANMOD:-1}"
export OAI_AMMSE_CE_RFSIM_CHANNEL_MODEL="${OAI_AMMSE_CE_RFSIM_CHANNEL_MODEL:-Rayleigh8}"
export OAI_AMMSE_CE_RFSIM_SPEED_KMH="${OAI_AMMSE_CE_RFSIM_SPEED_KMH:-0}"
export OAI_AMMSE_CE_RFSIM_NOISE_POWER_DB="${OAI_AMMSE_CE_RFSIM_NOISE_POWER_DB:--70}"
export OAI_AMMSE_CE_NOISE_POWER_DB="${OAI_AMMSE_CE_NOISE_POWER_DB:-${OAI_AMMSE_CE_RFSIM_NOISE_POWER_DB}}"

export OAI_CE_NMSE_ENABLE="${OAI_CE_NMSE_ENABLE:-1}"
export OAI_CE_NMSE_PERIOD="${OAI_CE_NMSE_PERIOD:-100}"

unset _ammse_config_file _ammse_config_dir _ammse_service_dir _ammse_oai_root
